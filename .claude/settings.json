{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild -list:*)",
      "Bash(xcodebuild build:*)",
      "Bash(xcodebuild -scheme Remaster:*)",
      "Bash(xcrun simctl list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./**/*.xcuserstate)"
    ]
  }
}
